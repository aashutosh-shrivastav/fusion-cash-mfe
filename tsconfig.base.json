{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "balance/Routes": [
        "./balance/src/app/remote-entry/entry.routes.ts"
      ],
      "payments/Routes": [
        "./payments/src/app/remote-entry/entry.routes.ts"
      ],
      "@fusion-cash-mfe/shared-core": [
        "./shared-core/src/index.ts"
      ],
      "@fusion-cash-mfe/shared-theme": [
        "./libs/shared-theme/src/index.ts"
      ],
      "@fusion-cash-mfe/shared-theme/*": [
        "./libs/shared-theme/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
